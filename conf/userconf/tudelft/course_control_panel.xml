<control_panel name="paparazzi control panel">
  <section name="programs">
    <program name="UnifiedMoCap" command="sw/ext/unifiedmocaprouter/build/mocap-router"/>
    <program name="GST" command="/usr/bin/gst-launch-1.0"/>
    <program name="RtpViewer" command="sw/tools/rtp_viewer/rtp_viewer.py">
      <arg flag="-s" constant="1"/>
      <arg flag="-r" constant="3"/>
    </program>
    <program name="VLC" command="$vlc">
      <arg flag="./sw/tools/rtp_viewer/rtp_5000.sdp"/>
    </program>
    <program name="VLC bottom camera" command="$vlc">
      <arg flag="./sw/tools/rtp_viewer/rtp_6000.sdp"/>
    </program>
    <program name="Video to window" command="sw/tools/video/video_to_gcs.sh">
      <arg flag="-i" constant="5000"/>
      <arg flag="-r" constant="counterclockwise"/>
      <arg flag="-w"/>
    </program>
    <program name="Bebop telnet at boot" command="sw/tools/parrot/bebop.py">
      <arg flag="install_autostart"/>
      <arg flag="native"/>
    </program>
  </section>
  <section name="sessions">

    <session name="Simulation - Gazebo">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-ping_period" constant="100"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--speech"/>
      </program>
      <program name="Joystick" command="sw/ground_segment/joystick/input2ivy">
        <arg flag="-ac" constant="@AIRCRAFT"/>
        <arg flag="sm600.xml"/>
        <arg flag="-d" constant="0"/>
      </program>
      <program name="Gazebo"/>
      <program name="Video to GCS">
        <arg flag="-i" constant="5000"/>
        <arg flag="-o" constant="5600"/>
        <arg flag="-r" constant="counterclockwise"/>
      </program>
    </session>

    <session name="Flight UDP">
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="UnifiedMoCap" command="sw/ext/unifiedmocaprouter/build/mocap-router">
        <arg flag="optitrack"/>
        <arg flag="ivy"/>
        <arg flag="--publish_frequency" constant="10"/>
        <arg flag="--coordinate_system" constant="enu"/>
        <arg flag="--coordinate_north" constant="far"/>
        <arg flag="--craft_noses" constant="right"/>
        <arg flag="--streaming_ids" constant="1"/>
        <arg flag="--ac_id" constant="@AC_ID"/>
      </program>
      <program name="Server"/>
      <program name="PprzGCS">
      </program>
      <program name="Joystick" command="sw/ground_segment/joystick/input2ivy">
        <arg flag="-ac" constant="@AIRCRAFT"/>
        <arg flag="sm600.xml"/>
        <arg flag="-d" constant="0"/>
      </program>
      <!--program name="NatNet3">
        <arg flag="-ac 9999" constant="@AC_ID"/>
        <arg flag="-xa" constant="57"/>
        <arg flag="-an" constant="far"/>
        <arg flag="-le" constant="far"/>
      </program-->
      <program name="Video to GCS">
        <arg flag="-i" constant="5000"/>
        <arg flag="-o" constant="5600"/>
        <arg flag="-r" constant="counterclockwise"/>
      </program>
    </session>
    <session name="Video to window">
      <program name="Video to window">
        <arg flag="-i" constant="5000"/>
        <arg flag="-r" constant="counterclockwise"/>
        <arg flag="-w"/>
      </program>
    </session>
    <!-- once per Bebop: telnet opens at every boot, no need to press the power button 4 times -->
    <session name="Bebop telnet at boot (once)">
      <program name="Bebop telnet at boot">
        <arg flag="install_autostart"/>
        <arg flag="native"/>
      </program>
    </session>
    <session name="Distance Counter">
      <program name="Optitrack Distance Counter"/>
    </session>

  </section>
</control_panel>
