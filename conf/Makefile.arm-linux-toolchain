# Minimal makefile for arm-linux cross compiling toolchain.
# Assuming installed in default location.
#
# If HARD_FLOAT is defined try to find armhf cross compiler, otherwise default to softfloat

ifdef HARD_FLOAT
PREFIX ?= arm-linux-gnueabihf-
else
PREFIX ?= arm-linux-gnueabi-
endif

#
# if gcc can't be found in path, try the codesourcery toolchain in /usr/local/codesourcery
#
ifeq ($(shell which $(PREFIX)gcc),)
ifndef HARD_FLOAT
  TOOLCHAIN=$(shell find -L /usr/local/codesourcery -maxdepth 2 -type d -name arm-none-linux-gnueabi 2>/dev/null | head -n 1)
  ifneq ($(TOOLCHAIN),)
    PREFIX=$(shell dirname $(TOOLCHAIN))/bin/arm-none-linux-gnueabi-
  endif
endif
endif

#
# if the compiler is not installed, run the compiler commands in a docker image that has it
# (docker/toolchains.txt), unless USE_DOCKER_TOOLCHAIN=0
#
USE_DOCKER_TOOLCHAIN ?= 1
ifeq ($(shell which $(PREFIX)gcc),)
ifneq ($(USE_DOCKER_TOOLCHAIN),0)
  TOOLCHAIN_IMAGE := $(shell $(PAPARAZZI_SRC)/docker/toolchain_image.sh $(PREFIX))
  ifneq ($(TOOLCHAIN_IMAGE),)
    $(info Cross-compiler $(PREFIX)gcc not installed: compiling in the docker image $(TOOLCHAIN_IMAGE))
    TOOLCHAIN_RUN = $(PAPARAZZI_SRC)/docker/toolchain_run.sh $(TOOLCHAIN_IMAGE)
  endif
endif
endif

# if toolchain could not be found, print some useful info
ifeq ($(TOOLCHAIN_RUN)$(shell which $(PREFIX)gcc),)
  # no suitable toolchain found...
  ifdef HARD_FLOAT
    $(error Error: arm-linux-gnueabihf-gcc cross-compiler not found! Please install the gcc-arm-linux-gnueabihf package.)
  else
    $(error Error: arm-linux-gnueabi-gcc cross-compiler not found! Please install the gcc-arm-linux-gnueabi package.)
  endif
endif

CC    = $(TOOLCHAIN_RUN) $(PREFIX)gcc
CXX   = $(TOOLCHAIN_RUN) $(PREFIX)g++
LD    = $(TOOLCHAIN_RUN) $(PREFIX)g++
AR    = $(TOOLCHAIN_RUN) $(PREFIX)ar
CP    = $(TOOLCHAIN_RUN) $(PREFIX)objcopy
DMP   = $(TOOLCHAIN_RUN) $(PREFIX)objdump
NM    = $(TOOLCHAIN_RUN) $(PREFIX)nm
SIZE  = $(TOOLCHAIN_RUN) $(PREFIX)size
STRIP = $(TOOLCHAIN_RUN) $(PREFIX)strip

GDB = $(shell which $(PREFIX)gdb)
ifeq ($(GDB),)
GDB = $(shell which gdb-multiarch)
endif


# some general commands
RM = rm
