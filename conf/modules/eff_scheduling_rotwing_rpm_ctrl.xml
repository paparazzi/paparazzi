      <define name="ROTWING_EFF_SCHED_CT_PUSHER" value="1"/>
      <define name="ROTWING_EFF_SCHED_ROLL_ARM" value="1"/>
      <define name="ROTWING_EFF_SCHED_PITCH_ARM" value="1"/>
