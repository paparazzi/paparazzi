<!DOCTYPE module SYSTEM "../module.dtd">

<module name="px4fmu_2.4_chibios" dir="boards">
  <doc>
    <description>
      Specific configuration for PX4FMU v2.4 with ChibiOS
    </description>
  </doc>
  <dep>
    <depends>spi_master,baro_ms5611_spi</depends>
  </dep>
  <makefile target="!sim|nps|fbw">
    <configure name="MS5611_SPI_DEV" value="spi1"/>
    <configure name="MS5611_SLAVE_IDX" value="SPI_SLAVE3"/>
  </makefile>
</module>

