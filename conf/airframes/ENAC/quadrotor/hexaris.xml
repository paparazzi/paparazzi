<!DOCTYPE airframe SYSTEM "../../airframe.dtd">

<airframe name="Hexa-Copter with tilted motors">

  <description>
    Fully actuated hexa copter with tilted motors
    * Autopilot: Tawaki
    * Telemetry: ESP32 DroneBridge
    * GPS: datalink
    * RC: SBUS
  </description>

  <firmware name="rotorcraft">
    <configure name="RTOS_DEBUG" value="FALSE" />
    <configure name="PERIODIC_FREQUENCY" value="500" />
    <configure name="AHRS_PROPAGATE_FREQUENCY" value="$(PERIODIC_FREQUENCY)" />
    
    <autopilot name="rotorcraft_fully_actuated"/>

    <target name="ap" board="tawaki_2.0">
      <module name="radio_control" type="sbus" />
      <define name="RADIO_KILL_SWITCH" value="RADIO_GAIN1" />
    </target>

    <target name="nps" board="pc">
      <module name="fdm" type="jsbsim" />
      <module name="radio_control" type="ppm" />
      <define name="TAWAKIV2_IMU_ROT" value="" />
      <define name="TAWAKIV2_MAG_ROT" value="" />
    </target>

    <module name="telemetry" type="transparent" />

    <module name="actuators" type="dshot">
      <configure name="DSHOT_BIDIR" value="TRUE" />
      <define name="USE_GPT8" value="TRUE" />
      <define name="DSHOT2_BIDIR_GPT" value="GPTD8" />
    </module>

    <module name="board" type="tawaki_2.0">
      <define name="USE_DSHOT_TIM1" value="TRUE" />
      <define name="DSHOT_TELEMETRY_TIMEOUT_MS" value="3" />
      <define name="USE_PWM1" value="FALSE" />
      <define name="USE_PWM2" value="FALSE" />
      <define name="IMU_MPU_LOWPASS_FILTER" value="MPU60X0_DLPF_256HZ" />
      <define name="IMU_MPU_ACCEL_LOWPASS_FILTER" value="MPU60X0_DLPF_ACC_218HZ" />
      <define name="IMU_MPU_SMPLRT_DIV" value="0" />
    </module>

    <module name="ahrs" type="int_cmpl_quat">
      <configure name="USE_MAGNETOMETER" value="FALSE"/>
    </module>
    <module name="ins" type="hff_extended">
      <define name="HFF_R_POS" value="0.3"/>
      <define name="HFF_R_GPS_SPEED" value="4.0"/>
      <define name="HFF_UPDATE_GPS_SPEED" value="FALSE"/>
    </module>
    <!--define name="INS_EKF2_MAG_FUSION_MODE" value="MAG_FUSE_TYPE_NONE"/-->

    <module name="stabilization" type="indi">
      <configure name="INDI_NUM_ACT" value="6" />
      <configure name="INDI_OUTPUTS" value="6" />
    </module>
    <module name="guidance" type="indi_fully_actuated" />

    <module name="pdec">
      <configure name="PDEC_UART" value="UART7" />
    </module>
    <module name="uwb_positioning">
      <!-- <configure name="UWB_POSITIONING_USE_AS_LOCAL_POS" value="FALSE|TRUE"/> -->
      <configure name="UWB_POSITIONING_USE_AS_GPS" value="TRUE"/>
      <configure name="UWB_POSITIONING_USE_AS_LOCAL_POS" value="FALSE"/>
    </module>
    <module name="gps"></module>

    <module name="sonar" type="vl53l1x">
      <configure name="SONAR_VL53L1X_I2C_DEV" value="i2c2"/>
      <!-- <define name="SENSOR_SYNC_SEND_SONAR"/> -->
      <define name="USE_SONAR"/>
    </module>

    <module name="opticflow" type="pmw3901">
      <configure name="OPTICFLOW_PMW3901_SPI_DEV" value="spi2"/>
      <configure name="OPTICFLOW_PMW3901_SPI_SLAVE_IDX" value="SPI_SLAVE0"/>
      <define name="OPTICFLOW_PMW3901_SENSOR_ANGLE" value="180"/>
      <define name="SENSOR_SYNC_SEND_OPTICFLOW_PMW3901" value="TRUE"/>
      <define name="USE_SPI_SLAVE0"/>
    </module>

    <module name="jevois">
      <configure name="JEVOIS_UART" value="uart3"/>
    </module>

    <module name="flight_recorder" />
    <module name="logger" type="control_effectiveness">
      <define name="LOGGER_CONTROL_EFFECTIVENESS_ACTUATORS" value="TRUE" />
      <define name="LOGGER_CONTROL_EFFECTIVENESS_COMMANDS" value="TRUE" />
    </module>

    <module name="sys_id_doublet" />
    <module name="sys_id_auto_doublets" />

  </firmware>

  <servos driver="DShot">
    <servo name="M1" no="3" min="0" neutral="100" max="2000" />
    <servo name="M2" no="1" min="0" neutral="100" max="2000" />
    <servo name="M3" no="5" min="0" neutral="100" max="2000" />
    <servo name="M4" no="2" min="0" neutral="100" max="2000" />
    <servo name="M5" no="4" min="0" neutral="100" max="2000" />
    <servo name="M6" no="6" min="0" neutral="100" max="2000" />
  </servos>

  <commands>
    <axis name="M1" failsafe_value="MOTOR_STOP" />
    <axis name="M2" failsafe_value="MOTOR_STOP" />
    <axis name="M3" failsafe_value="MOTOR_STOP" />
    <axis name="M4" failsafe_value="MOTOR_STOP" />
    <axis name="M5" failsafe_value="MOTOR_STOP" />
    <axis name="M6" failsafe_value="MOTOR_STOP" />
    <axis name="THRUST" failsafe_value="0" />
  </commands>

  <command_laws>
    <call fun="sys_id_doublet_add_values(autopilot_get_motors_on(),FALSE,values)" />
    <set servo="M1" value="@M1" />
    <set servo="M2" value="@M2" />
    <set servo="M3" value="@M3" />
    <set servo="M4" value="@M4" />
    <set servo="M5" value="@M5" />
    <set servo="M6" value="@M6" />
  </command_laws>

  <section name="IMU" prefix="IMU_">
    <define name="ACCEL_CALIB" type="array">
      <field type="struct">
        <field name="abi_id" value="24" />
        <field name="calibrated" type="struct">
          <field name="neutral" value="true" />
          <field name="scale_f" value="true" />
          <field name="rotation" value="true" />
        </field>
        <field name="neutral" value="0,-14,8" type="int[]" />
        <field name="scale_f" value="{ 2.4477, 2.4541, 2.4509 }" />
        <field value="TAWAKIV2_IMU_ROT" />
      </field>
    </define>
    <define name="GYRO_CALIB" type="array">
      <field type="struct">
        <field name="abi_id" value="24" />
        <field name="calibrated" type="struct">
          <field name="neutral" value="false" />
          <field name="scale" value="false" />
          <field name="rotation" value="true" />
        </field>
        <field value="TAWAKIV2_IMU_ROT" />
      </field>
    </define>
    <define name="MAG_CALIB" type="array">
      <field type="struct">
        <field name="abi_id" value="3" />
        <field name="calibrated" type="struct">
          <field name="neutral" value="true" />
          <field name="scale_f" value="true" />
          <field name="rotation" value="true" />
        </field>
        <field name="neutral" value="-1236,-1089,-842" type="int[]"/>
        <field name="scale_f" value="{ 0.6092, 0.6116, 0.6131 }"/>
        <field value="TAWAKIV2_MAG_ROT" />
      </field>
    </define>

    <define name="BODY_TO_IMU_PHI" value="0." unit="deg" />
    <define name="BODY_TO_IMU_THETA" value="0." unit="deg" />
    <define name="BODY_TO_IMU_PSI" value="180." unit="deg" />
  </section>

  <include href="conf/mag/toulouse_muret.xml" />

  <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
    <!-- setpoint limits for attitude stabilization rc flight -->
    <define name="SP_MAX_PHI" value="45" unit="deg" />
    <define name="SP_MAX_THETA" value="45" unit="deg" />
    <define name="SP_MAX_R" value="60" unit="deg/s" />
    <define name="DEADBAND_A" value="0" />
    <define name="DEADBAND_E" value="0" />
    <define name="DEADBAND_R" value="50" />
  </section>

  <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
    <!-- reference acceleration for attitude control -->
    <define name="REF_ERR_P" value="120" />
    <define name="REF_ERR_Q" value="130" />
    <define name="REF_ERR_R" value="120" />
    <define name="REF_RATE_P" value="25.0" />
    <define name="REF_RATE_Q" value="17.0" />
    <define name="REF_RATE_R" value="10.0" />

    <define name="MAX_R" value="120" unit="deg/s" />

    <!-- second order filter parameters -->
    <define name="FILT_CUTOFF" value="4.0" />
    <define name="FILT_CUTOFF_R" value="4.0" />

    <!-- Adaptive Learning Rate -->
    <define name="USE_ADAPTIVE" value="FALSE" />
    <define name="ADAPTIVE_MU" value="0.0001" />

    <!-- control effectiveness Hexa Form-->
    <define name="G1" type="matrix">
      <field value="11.86, 23.72, 11.86, -11.86, -23.72, -11.86" type="float[]"/>
      <field value="-10.76, 0.00, 10.76, 10.76, 0.00, -10.76" type="float[]"/>
      <field value="8.30, -8.30, 8.30, -8.30, 8.30, -8.30" type="float[]"/>
      <field value="0.25, -0.51, 0.25, 0.25, -0.51, 0.25" type="float[]"/>
      <field value="-0.34, 0.00, 0.34, -0.34, 0.00, 0.34" type="float[]"/>
      <field value="-0.29, -0.29, -0.29, -0.29, -0.29, -0.29" type="float[]"/>
    </define>
    <define name="G2" value="{49.03, -49.03, 49.03, -49.03, 49.03, -49.03}"/>
    <define name="ACT_FREQ" value="{15.20, 15.20, 15.20, 15.20, 15.20, 15.20}"/>

    <!-- INDI outputs to commands association -->
    <define name="COMMANDS" value="{COMMAND_M1, COMMAND_M2, COMMAND_M3, COMMAND_M4, COMMAND_M5, COMMAND_M6}" />

    <define name="ESTIMATION_FILT_CUTOFF" value="4.0" />

    <!-- Priority for each axis -->
    <!-- ROLL,PITCH,YAW,Tx,Ty,Tz -->
    <define name="WLS_PRIORITIES" value="{10000, 10000, 100, 100, 100, 1000}" />
    <define name="RPM_FEEDBACK" value="FALSE" />

    <!-- Thrusters contribute to global force in all directions -->
    <define name="ACT_THRUST_MAT" type="matrix">
      <field name="THRUST_X" value="{1,1,1,1,1,1}" />
      <field name="THRUST_Y" value="{1,0,1,1,0,1}" />
      <field name="THRUST_Z" value="{1,1,1,1,1,1}" />
    </define>

    <define name="V_THRUST_X" value="5.0"/>
    <define name="V_THRUST_Y" value="5.0"/>

  </section>

  <section name="WLS" prefix="WLS_">
    <define name="N_U_MAX" value="6" />
    <define name="N_V_MAX" value="6" />
  </section>

  <section name="GUIDANCE_V" prefix="GUIDANCE_V_">
    <define name="REF_MIN_ZDD" value="-0.4*9.81" />
    <define name="REF_MAX_ZDD" value=" 0.4*9.81" />
    <define name="REF_MIN_ZD" value="-1.5" />
    <define name="REF_MAX_ZD" value=" 1." />
  </section>

  <section name="GUIDANCE_H" prefix="GUIDANCE_H_">
    <define name="MAX_BANK" value="20" unit="deg" />
    <define name="REF_MAX_SPEED" value="0.3"/>
  </section>

  <section name="GUIDANCE_INDI" prefix="GUIDANCE_INDI_">
    <define name="MASS" value="0.41" />
    <define name="POS_GAIN" value="1" />
    <define name="SPEED_GAIN" value="1.5" />
  </section>

  <section name="NAV">
    <define name="ARRIVED_AT_WAYPOINT" value="0.25" />
    <define name="NAV_DESCEND_VSPEED" value="-0.5" />
    <define name="NAV_CLIMB_VSPEED" value="0.5" />
    <define name="NAV_RADIUS" value="1.5" />
    <define name="FAILSAFE_THROTTLE" value="0.1*MAX_PPRZ"/>
  </section>

  <section name="BAT">
    <define name="CRITIC_BAT_LEVEL" value="9.3" unit="V" />
  </section>

  <section name="AUTOPILOT">
    <define name="MODE_STARTUP" value="AP_MODE_NAV" />
    <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE_DIRECT" />
    <define name="MODE_AUTO1" value="AP_MODE_ATTITUDE_FULLY_ACTUATED" />
    <define name="MODE_AUTO2" value="AP_MODE_NAV" />
  </section>

  <section name="GCS">
    <define name="ALT_SHIFT_PLUS_PLUS" value="5" />
    <define name="ALT_SHIFT_PLUS" value="1" />
    <define name="ALT_SHIFT_MINUS" value="-1" />
  </section>

  <section name="SIMULATOR" prefix="NPS_">
    <define name="ACTUATOR_NAMES" value="motor1,motor2,motor3,motor4,motor5,motor6" type="string[]" />
    <define name="JSBSIM_MODEL" value="Hexaris" type="string" />
    <define name="COMMANDS_NB" value="6" />
    <define name="NO_MOTOR_MIXING" value="TRUE" />
  </section>

  <section name="SYS_ID" prefix="SYS_ID_">
    <define name="DOUBLET_AXES" value="{COMMAND_M1, COMMAND_M2, COMMAND_M3, COMMAND_M4, COMMAND_M5, COMMAND_M6}" />
    <define name="AUTO_DOUBLETS_N_ACTUATORS" value="6" />
    <define name="AUTO_DOUBLETS_ACTUATORS" value="{0,1,2,3,4,5}" />
    <define name="AUTO_DOUBLETS_AMPLITUDE" value="{2000,2000,2000,2000,2000,2000}" />
    <define name="AUTO_DOUBLETS_REPEATS" value="3" />
    <define name="AUTO_DOUBLETS_INTERVAL" value="2." />
  </section>

  <section name="UWB_POSITIONING" prefix="UWB_POSITIONING_">
    <define name="NB_ANCHORS" value="4"/>
    <define name="ANCHORS_IDS" value="{0x9591, 0xFC17, 0x7223, 0x9E7A}"/>
    <define name="ANCHORS_POS_X" value="{-1, -1, 5.4, 5.4}"/>
    <define name="ANCHORS_POS_Y" value="{0, 8.8, 8.8, 0}"/>
    <define name="ANCHORS_POS_Z" value="{0.4, 1.7, 0.4, 1.7}"/>
    <define name="TAG_ID" value="0xCFDC"/>
    <define name="USE_EKF" value="FALSE"/>
  </section>

  <section name="AHRS" prefix="AHRS_">
    <define name="MAG_YAW_OFFSET" value="35" unit="deg"/>
  </section>

</airframe>
